NEXT_PUBLIC_API_URL=/api/v1
BACKEND_API_URL=http://127.0.0.1:3000/api/v1

# Socket.IO connects directly to the API host (not through the Next.js /api/v1 proxy).
NEXT_PUBLIC_WS_URL=http://127.0.0.1:3000

# Local full stack: false. Vercel marketing-only: set both true (see docs/COMING_SOON_VERCEL_LAUNCH.md)
NEXT_PUBLIC_COMING_SOON=false
COMING_SOON=false

# Social (optional override; defaults to Mentor Lagbe YouTube + Facebook)
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@MentorLagbe
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/mentorlagbe

# Built-in Jitsi (Phase 1: meet.jit.si; Phase 2: self-hosted domain — change only these)
# Set false for manual Google Meet links from the mentor dashboard.
NEXT_PUBLIC_JITSI_ENABLED=false
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
